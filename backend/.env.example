# Copy to .env and fill in. Every value below is a working local default
# except GOOGLE_APPLICATION_CREDENTIALS, which needs your own Firebase project.

# Django signing key. Generate a random one for anything that is not local:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=secret

# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgres://baseapi:secret@localhost:5432/baseapi

# Matches the redis service in docker-compose.yml
CELERY_BROKER_URL=redis://localhost:6379

# Path to the Firebase service account JSON used to verify ID tokens and send
# push notifications. Firebase console > Project settings > Service accounts.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json

# Optional. Firebase UID that receives a push notification after each scrape
# run. Leave empty to disable those notifications.
ADMIN_USER_ID=
